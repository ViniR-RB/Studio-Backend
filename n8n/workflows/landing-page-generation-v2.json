{
  "name": "Landing Page Generator - Codex",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "landing-page-generation", "responseMode": "onReceived"},
      "name": "Receive generation",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://open-design:7456/api/projects",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.OD_API_TOKEN }}"}]},
        "sendBody": true,
        "jsonBody": "={{ { id: 'job-' + $('Receive generation').first().json.body.job_id, name: 'Landing page ' + $('Receive generation').first().json.body.job_id } }}",
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "name": "Create OpenDesign project",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://open-design:7456/api/chat",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.OD_API_TOKEN }}"}]},
        "sendBody": true,
        "jsonBody": "={{ { agentId: 'codex', projectId: $json.project.id, sessionMode: 'design', message: 'Use the Codex CLI and the open-design MCP server. Create a complete landing page for this product. Write the final page to index.html in the current project. Return only a short completion message after saving the file. Product: ' + JSON.stringify($('Receive generation').first().json.body.product) } }}",
        "options": {"response": {"response": {"responseFormat": "text"}}, "timeout": 600000}
      },
      "name": "Generate with Codex and MCP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {"jsCode": "const raw = String($json.data ?? $json.body ?? $json);\nconst events = [];\nfor (const frame of raw.split(/\\n\\n+/)) {\n  const event = frame.match(/^event:\\s*(.+)$/m)?.[1]?.trim();\n  const data = frame.match(/^data:\\s*(.+)$/m)?.[1]?.trim();\n  if (!data) continue;\n  try { events.push({ event, data: JSON.parse(data) }); } catch {}\n}\nconst end = events.findLast((entry) => entry.event === 'end')?.data;\nif (!end || end.status !== 'succeeded') throw new Error('OpenDesign/Codex did not complete successfully');\nconst artifactPath = end.artifactPaths?.find((path) => /\\.html?$/i.test(path)) ?? 'index.html';\nconst projectId = $('Create OpenDesign project').first().json.project.id;\nconst jobId = $('Receive generation').first().json.job_id;\nreturn [{ json: { job_id: jobId, project_id: projectId, artifact_path: artifactPath, slug: $('Receive generation').first().json.product.product_name.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') } }];"},
      "name": "Read generated artifact path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://open-design:7456/api/projects/' + $json.project_id + '/raw/' + $json.artifact_path }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.OD_API_TOKEN }}"}]},
        "options": {"response": {"response": {"responseFormat": "text"}}}
      },
      "name": "Read generated HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0]
    },
    {
      "parameters": {"jsCode": "const html = String($json.data ?? $json.body ?? $json).trim();\nif (!/<html[\\s>]/i.test(html) || html.length > 500000) throw new Error('OpenDesign artifact is not valid HTML');\nreturn [{ json: { job_id: $('Read generated artifact path').first().json.job_id, slug: $('Read generated artifact path').first().json.slug, html } }];"},
      "name": "Validate HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://api:8000/api/v1/internal/generations/' + $json.job_id + '/result' }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.INTERNAL_API_TOKEN }}"}]},
        "sendBody": true,
        "jsonBody": "={{ { html: $json.html, slug: $json.slug } }}",
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "name": "Save HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://api:8000/api/v1/internal/generations/' + $('Validate HTML').first().json.job_id + '/publish/' + $json.version_id }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.INTERNAL_API_TOKEN }}"}]},
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "name": "Publish landing page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 0]
    }
  ],
  "connections": {
    "Receive generation": {"main": [[{"node": "Create OpenDesign project", "type": "main", "index": 0}]]},
    "Create OpenDesign project": {"main": [[{"node": "Generate with Codex and MCP", "type": "main", "index": 0}]]},
    "Generate with Codex and MCP": {"main": [[{"node": "Read generated artifact path", "type": "main", "index": 0}]]},
    "Read generated artifact path": {"main": [[{"node": "Read generated HTML", "type": "main", "index": 0}]]},
    "Read generated HTML": {"main": [[{"node": "Validate HTML", "type": "main", "index": 0}]]},
    "Validate HTML": {"main": [[{"node": "Save HTML", "type": "main", "index": 0}]]},
    "Save HTML": {"main": [[{"node": "Publish landing page", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {},
  "versionId": "landing-page-generation-v2"
}
