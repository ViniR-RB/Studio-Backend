{
  "name": "Landing Page Generation",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "landing-page-generation", "responseMode": "onReceived"},
      "name": "Receive generation",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://open-design:7456/api/chat",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "Bearer {{$env.OD_API_TOKEN}}"}]},
        "sendBody": true,
        "jsonBody": "={{ { message: 'Generate only a safe landing page HTML for this product: ' + JSON.stringify($json.product) } }}",
        "options": {"response": {"response": {"responseFormat": "text"}}}
      },
      "name": "Generate HTML with OpenDesign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {"jsCode": "const body = $json.data ?? $json;\nconst html = typeof body === 'string' ? body : body.html;\nif (!html || html.length > 500000) throw new Error('OpenDesign did not return valid HTML');\nreturn [{ json: { job_id: $('Receive generation').first().json.job_id, slug: $('Receive generation').first().json.product.product_name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''), html } }];"},
      "name": "Validate HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://api:8000/api/v1/internal/generations/' + $json.job_id + '/result' }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "Bearer {{$env.INTERNAL_API_TOKEN}}"}]},
        "sendBody": true,
        "jsonBody": "={{ { html: $json.html, slug: $json.slug } }}",
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "name": "Save HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Receive generation": {"main": [[{"node": "Generate HTML with OpenDesign", "type": "main", "index": 0}]]},
    "Generate HTML with OpenDesign": {"main": [[{"node": "Validate HTML", "type": "main", "index": 0}]]},
    "Validate HTML": {"main": [[{"node": "Save HTML", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {},
  "versionId": "landing-page-generation-v1"
}
