POSTGRES_DB=dropshipping
POSTGRES_USER=dropshipping
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://dropshipping:change-me@postgres:5432/dropshipping
INTERNAL_API_TOKEN=change-me
N8N_WEBHOOK_URL=http://n8n:5678/webhook/landing-page-generation
# Pin this to a tested OpenDesign release or digest before production.
OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:latest
# Codex ChatGPT/device login is persisted in this volume; no API key is required.
CODEX_HOME=/app/.codex
OD_API_TOKEN=change-me
N8N_ENCRYPTION_KEY=change-me
SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=604800
FRONTEND_ORIGINS=http://localhost:4200
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
OPENAI_BASE_URL=http://host.docker.internal:20128/v1
OPENAI_API_KEY=sua-chave-do-9router
