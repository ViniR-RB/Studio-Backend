ARG OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:latest
FROM ${OPEN_DESIGN_IMAGE}

USER root
RUN npm install --global @openai/codex@latest
USER open-design

WORKDIR /app
COPY start-open-design.sh /usr/local/bin/start-open-design
USER root
RUN chmod +x /usr/local/bin/start-open-design
ENV PATH="/app/apps/daemon/bin:${PATH}"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/usr/local/bin/start-open-design"]
